---
import site from '../../data/site.json';
---

<footer class="site-footer" id="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Philosophy -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <span class="bracket">[</span>
          <span class="glyph">◈</span>
          <span class="name">CRYSTAL_STUDIO_LABS</span>
          <span class="bracket">]</span>
        </div>
        <p class="footer-tagline">{site.tagline}</p>
        <div class="invariants-badge">
          <span class="badge-icon">⚡</span>
          <span>STRICT &lt;25MB MEMORY CEILING // ZERO VENDOR TELEMETRY</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col links-col">
        <div class="footer-heading">// PLATFORM_MATRIX</div>
        <ul class="footer-links">
          {site.nav.map(item => (
            <li>
              <a href={item.href} class="footer-link">
                <span class="arrow">→</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/sitemap-index.xml" class="footer-link" target="_blank" rel="noopener">
              <span class="arrow">→</span>
              <span>SITEMAP_INDEX.XML</span>
            </a>
          </li>
          <li>
            <a href="/robots.txt" class="footer-link" target="_blank" rel="noopener">
              <span class="arrow">→</span>
              <span>ROBOTS.TXT</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Repositories & Contact -->
      <div class="footer-col contact-col">
        <div class="footer-heading">// OPEN_SOURCE_DISPATCH</div>
        <div class="contact-info">
          <div class="info-row">
            <span class="info-label">ORGANIZATION:</span>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="info-val">github.com/Crystal-Studio-Labs</a>
          </div>
          <div class="info-row">
            <span class="info-label">DISCLOSURES:</span>
            <a href={site.social.email} class="info-val">{site.email}</a>
          </div>
          <div class="info-row">
            <span class="info-label">HOSTING:</span>
            <span class="info-val">GitHub Pages (Static Native)</span>
          </div>
        </div>

        <button type="button" id="back-to-top" class="back-to-top-btn" aria-label="Back to top of page">
          <span>▲ TOP_OF_STACK</span>
        </button>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-copy">
        {site.footer.copy}
      </div>
      <div class="footer-telemetry">
        <span class="telemetry-beacon"></span>
        <span class="telemetry-text">NODE STATUS: VERIFIED 100% STATIC</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-thick);
    background-color: var(--bg-secondary);
    padding: 3.5rem 0 2rem;
    position: relative;
    z-index: 10;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1.2fr;
    }
  }

  .footer-brand {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .bracket, .glyph {
    color: var(--accent-cyan);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .invariants-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    border: 2px solid var(--border-color);
    background-color: var(--bg-surface);
    color: var(--accent-cyan);
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.4rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .footer-link .arrow {
    color: var(--text-muted);
    transition: transform 0.15s ease;
  }

  .footer-link:hover {
    color: var(--accent-cyan);
  }

  .footer-link:hover .arrow {
    transform: translateX(3px);
    color: var(--accent-cyan);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 1.5rem;
  }

  .info-row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .info-label {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .info-val {
    color: var(--text-primary);
    word-break: break-all;
  }

  .info-val:hover {
    color: var(--accent-cyan);
  }

  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    border: 2px solid var(--border-color);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    cursor: pointer;
    box-shadow: 2px 2px 0px var(--border-color);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .back-to-top-btn:hover {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--border-color);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .footer-bottom {
    border-top: 2px solid var(--border-color);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-telemetry {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-green);
    font-weight: 700;
  }

  .telemetry-beacon {
    width: 8px;
    height: 8px;
    background-color: var(--accent-green);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-green);
  }
</style>

<script>
  const backToTop = document.getElementById('back-to-top');
  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
