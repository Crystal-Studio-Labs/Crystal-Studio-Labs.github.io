---
import site from '../../data/site.json';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="Crystal Studio Labs Home">
      <span class="brand-bracket">[</span>
      <span class="brand-glyph">◈</span>
      <span class="brand-text">CRYSTAL_STUDIO_LABS</span>
      <span class="brand-bracket">]</span>
    </a>

    <!-- Desktop Navigation (1024px+) -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <ul class="nav-list">
        {site.nav.map(item => (
          <li class="nav-item">
            <a 
              href={item.href} 
              class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="link-prefix">//</span>
              <span class="link-label">{item.label}</span>
              {isActive(item.href) && <span class="active-block" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Theme + GitHub + Mobile Toggle) -->
    <div class="header-actions">
      <!-- Theme Switcher -->
      <button 
        type="button" 
        id="theme-toggle" 
        class="action-btn theme-btn" 
        aria-label="Toggle visual theme (Dark / Light)"
        title="Toggle Visual Theme"
      >
        <span class="theme-icon-dark" aria-hidden="true">☾</span>
        <span class="theme-icon-light" aria-hidden="true">☼</span>
        <span class="sr-only">Toggle Theme</span>
      </button>

      <!-- GitHub Fleet Link -->
      <a 
        href={site.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="action-btn github-btn"
        aria-label="Crystal Studio Labs on GitHub (opens in new tab)"
      >
        <svg class="gh-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span class="gh-label">GITHUB</span>
      </a>

      <!-- Mobile Menu Hamburger Button (<1024px) -->
      <button 
        type="button" 
        id="mobile-menu-trigger" 
        class="mobile-menu-btn" 
        aria-expanded="false" 
        aria-controls="mobile-drawer"
        aria-label="Open navigation menu"
      >
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Slide-In Navigation Drawer -->
  <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-header">
      <div class="drawer-title">[// NAVIGATION_MATRIX]</div>
      <button type="button" id="drawer-close-btn" class="drawer-close-btn" aria-label="Close navigation menu">
        [ESC/✕]
      </button>
    </div>
    <nav class="drawer-nav" aria-label="Mobile Navigation">
      <ul class="drawer-list">
        {site.nav.map(item => (
          <li class="drawer-item">
            <a 
              href={item.href} 
              class={`drawer-link ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="drawer-num">0{site.nav.indexOf(item) + 1}</span>
              <span class="drawer-label">{item.label}</span>
              <span class="drawer-arrow">→</span>
            </a>
          </li>
        ))}
        <li class="drawer-item">
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="drawer-link external">
            <span class="drawer-num">05</span>
            <span class="drawer-label">GITHUB_ORG</span>
            <span class="drawer-arrow">↗</span>
          </a>
        </li>
      </ul>
    </nav>
    <div class="drawer-footer">
      <div class="drawer-meta">CRYSTAL STUDIO LABS v1.0.0</div>
      <div class="drawer-status">
        <span class="status-pulse"></span>
        <span>ALL SYSTEMS OPERATIONAL</span>
      </div>
    </div>
  </div>
  <div id="drawer-backdrop" class="drawer-backdrop" tabindex="-1"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: var(--bg-primary);
    border-bottom: var(--border-thick);
    backdrop-filter: blur(12px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    padding: 0.5rem 0;
  }

  .brand-bracket {
    color: var(--accent-cyan);
    font-weight: 700;
  }

  .brand-glyph {
    color: var(--accent-cyan);
  }

  .brand-link:hover .brand-text {
    color: var(--accent-cyan);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    position: relative;
  }

  .link-prefix {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .nav-link:hover {
    color: var(--accent-cyan);
  }

  .nav-link.active {
    color: var(--text-primary);
    background-color: var(--bg-surface-elevated);
    border-left: 2px solid var(--accent-cyan);
  }

  .nav-link.active .link-prefix {
    color: var(--accent-cyan);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    border: 2px solid var(--border-color);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    box-shadow: 2px 2px 0px var(--border-color);
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.1s ease, border-color 0.15s ease;
  }

  .action-btn:hover {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--border-color);
    border-color: var(--accent-cyan);
  }

  .github-btn {
    gap: 0.5rem;
  }

  @media (max-width: 640px) {
    .github-btn {
      display: none;
    }
  }

  .theme-btn {
    width: 40px;
    padding: 0;
    font-size: 1.1rem;
  }

  .theme-icon-light {
    display: none;
  }

  [data-theme='light'] .theme-icon-dark {
    display: none;
  }

  [data-theme='light'] .theme-icon-light {
    display: inline-block;
  }

  /* Mobile Hamburger Button */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 8px;
    border: 2px solid var(--border-color);
    background-color: var(--bg-surface);
    cursor: pointer;
    box-shadow: 2px 2px 0px var(--border-color);
  }

  @media (min-width: 1024px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .bar {
    width: 22px;
    height: 3px;
    background-color: var(--text-primary);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 380px;
    background-color: var(--bg-secondary);
    border-left: var(--border-thick);
    z-index: 200;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -6px 0px 24px rgba(0, 0, 0, 0.6);
  }

  .mobile-drawer.open {
    transform: translateX(0);
  }

  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 150;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: var(--border-thick);
    background-color: var(--bg-surface);
  }

  .drawer-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .drawer-close-btn {
    background: transparent;
    border: 2px solid var(--border-color);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    min-height: 44px;
    min-width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .drawer-close-btn:hover {
    background-color: var(--accent-danger);
    color: #ffffff;
    border-color: var(--accent-danger);
  }

  .drawer-nav {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .drawer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    min-height: 52px;
    border: 2px solid var(--border-color);
    background-color: var(--bg-surface);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    box-shadow: 2px 2px 0px var(--border-color);
  }

  .drawer-num {
    color: var(--accent-cyan);
    font-size: 0.8125rem;
  }

  .drawer-label {
    flex: 1;
    margin-left: 1rem;
    letter-spacing: 0.05em;
  }

  .drawer-arrow {
    color: var(--text-muted);
  }

  .drawer-link:hover, .drawer-link.active {
    background-color: var(--bg-surface-elevated);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px transparent;
  }

  .drawer-link.active .drawer-arrow {
    color: var(--accent-cyan);
  }

  .drawer-footer {
    padding: 1.25rem 1.5rem;
    border-top: var(--border-thick);
    background-color: var(--bg-surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .drawer-meta {
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .drawer-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-green);
    font-weight: 700;
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  // Mobile Drawer & Keyboard Accessibility
  const menuTrigger = document.getElementById('mobile-menu-trigger');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const closeBtn = document.getElementById('drawer-close-btn');

  function openDrawer() {
    drawer?.classList.add('open');
    backdrop?.classList.add('open');
    drawer?.setAttribute('aria-hidden', 'false');
    menuTrigger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    backdrop?.classList.remove('open');
    drawer?.setAttribute('aria-hidden', 'true');
    menuTrigger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    menuTrigger?.focus();
  }

  menuTrigger?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) {
      closeDrawer();
    }
  });

  // Dark/Light Theme Controller with System Sync & Zero-Flicker Persistence
  const themeToggle = document.getElementById('theme-toggle');

  function toggleTheme() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', nextTheme);
    localStorage.setItem('csl-theme', nextTheme);
  }

  themeToggle?.addEventListener('click', toggleTheme);
</script>
