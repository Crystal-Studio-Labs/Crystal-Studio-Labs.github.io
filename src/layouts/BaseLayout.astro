---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../../data/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  jsonLd?: object;
  currentPath?: string;
}

const {
  title = `${site.name} | Autonomous Systems & Tools`,
  description = site.description,
  image = '/og-image.png',
  canonical,
  type = 'website',
  jsonLd,
  currentPath = Astro.url.pathname
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, site.url).href;
const fullImageUrl = new URL(image, site.url).href;

// Default Organization & WebSite JSON-LD
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      'name': site.name,
      'url': site.url,
      'email': site.email,
      'description': site.description,
      'sameAs': [site.github]
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      'url': site.url,
      'name': site.name,
      'description': site.tagline,
      'publisher': { '@id': `${site.url}/#organization` }
    }
  ]
};

const finalJsonLd = jsonLd || defaultJsonLd;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Zero-Flash Theme Script -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('csl-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{title.length > 60 ? title.substring(0, 57) + '...' : title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description.length > 160 ? description.substring(0, 157) + '...' : description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark light" />

    <!-- Favicon Suite -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} - Crystal Studio Labs`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:image:alt" content={`${title} - Crystal Studio Labs`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
  </head>
  <body>
    <!-- Skip to Content Accessible Link -->
    <a href="#main-content" class="skip-link">SKIP TO MAIN CONTENT [TAB]</a>

    <!-- Background Grid & Scanline FX -->
    <div class="cyber-grid-bg" aria-hidden="true"></div>
    <div class="scanline-overlay" aria-hidden="true"></div>

    <!-- Header Navigation -->
    <Header currentPath={currentPath} />

    <!-- Main Landmark -->
    <main id="main-content" class="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background-color: var(--accent-cyan);
    color: #000000;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.75rem 1.25rem;
    border: 3px solid #000000;
    z-index: 9999;
    box-shadow: 4px 4px 0px #000000;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }
</style>
